{
  "name": "wishpers-quack-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Wishpers: QUACK Edition on DuckChain",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy.js --network duckchainTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network duckchain",
    "deploy:somniaTestnet": "hardhat run scripts/deploy.js --network somniaTestnet",
    "deploy:somnia": "hardhat run scripts/deploy.js --network somnia",
    "check:rpc": "node scripts/checkRpc.js",
    "deploy:oracle": "hardhat run scripts/deployPriceOracleMock.js --network somniaTestnet",
    "deploy:lending": "hardhat run scripts/deployLendingMocks.js --network somniaTestnet",
    "deploy:staking": "hardhat run scripts/deployStakingMocks.js --network somniaTestnet",
    "deploy:mockAdapter": "hardhat run scripts/deployMockAdapter.js --network somniaTestnet",
    "verify:testnet": "hardhat verify --network duckchainTestnet",
    "verify:mainnet": "hardhat verify --network duckchain",
    "verify:somniaTestnet": "hardhat verify --network somniaTestnet",
    "verify:somnia": "hardhat verify --network somnia"
  },
  "keywords": [
    "duckchain",
    "trading",
    "ai-agents",
    "defi",
    "ethereum"
  ],
  "author": "Wishpers Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6"
  }
}