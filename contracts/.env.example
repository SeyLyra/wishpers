# Hardhat and network credentials
PRIVATE_KEY="0xYOUR_PRIVATE_KEY"
CHAIN_RPC_URL="https://dream-rpc.somnia.network"
CHAIN_ID="50312"
# Optional legacy network URLs (still supported)
DUCKCHAIN_RPC_URL="https://rpc.duckchain.com"
DUCKCHAIN_TESTNET_RPC_URL="https://testnet.duckchain.com"
SOMNIA_RPC_URL="https://rpc.somnia.network"
SOMNIA_TESTNET_RPC_URL="https://testnet.somnia.network"

# Optional: use existing tokens (otherwise local presets will be deployed)
BASE_TOKEN_ADDRESS="0xBaseTokenAddress"
PAYMENT_TOKEN_ADDRESS="0xPaymentTokenAddress"

# Treasury recipient for marketplace fees
TREASURY_ADDRESS="0xTreasuryAddress"

# Etherscan-like explorer API keys (optional)
SOMNIA_API_KEY=""
SOMNIA_TESTNET_API_KEY=""
# Quick Start
# ----------------------------------------
# Local Dev (Hardhat):
# - Usually does not require .env for the localhost network.
# - Run `npx hardhat node` and deploy with `--network localhost`.
# - If you prefer env-driven custom network, set CHAIN_RPC_URL=http://127.0.0.1:8545 and use `--network custom`.
#
# Testnet (Somnia/Sei EVM):
# - PRIVATE_KEY="0xYOUR_PRIVATE_KEY"
# - CHAIN_RPC_URL="https://dream-rpc.somnia.network" (or your RPC)
# - CHAIN_ID="50312" (or your chain id)